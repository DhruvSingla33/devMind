# Copy to .env and fill in for your machine / Google Cloud project.
# Vars prefixed EXPO_PUBLIC_ are inlined into the JS bundle by Expo/Metro.

# Aarambh-Backend base URL. Leave blank in local dev — the app derives
# http://<your-lan-ip>:5000/api/v1 automatically from the Expo dev server.
EXPO_PUBLIC_API_URL=

# OAuth 2.0 Client ID from Google Cloud Console (must match the audience
# Aarambh-Backend verifies against via GOOGLE_CLIENT_ID in its own .env).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
