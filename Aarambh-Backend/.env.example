PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/aarambh_db

# JWT Configuration
JWT_SECRET=supersecretjwtkey_change_in_production_12345!
JWT_ACCESS_EXPIRATION=1d
JWT_REFRESH_SECRET=supersecretrefreshkey_change_in_production_67890!
JWT_REFRESH_EXPIRATION=7d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Real SMS Gateway Options
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
FAST2SMS_API_KEY=your_fast2sms_api_key

# Real Email OTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME=Aarambh Learning

# AWS S3 Media Upload Configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=aarambh-media-assets
